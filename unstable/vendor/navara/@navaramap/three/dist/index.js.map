export default "#ifndef ELLIPSOID_GLSL\n#define ELLIPSOID_GLSL\n\n#define WGS84_A 6378137.0\n#define WGS84_B 6356752.3142451793\n\nconst vec3 WGS84_RADII = vec3(WGS84_A, WGS84_A, WGS84_B);\nconst vec3 ONE_OVER_WGS84_RADII = 1.0 / vec3(WGS84_A, WGS84_A, WGS84_B);\nconst vec3 ONE_OVER_WGS84_RADII_SQUARED = 1.0 / vec3(WGS84_A * WGS84_A, WGS84_A * WGS84_A, WGS84_B * WGS84_B);\n\nconst float WGS84_E2 = 0.00669438; \nconst float WGS84_E2_SECOND = 0.00673950; \n\nconst float WGS84_FLATTENING = 0.00335281; \nconst float WGS84_FLATTENING_RECIPROCAL = 298.257223563; \n\n#endif\nuniform sampler2D tGlobeDepth;\n#ifndef USE_LOGARITHMIC_DEPTH_BUFFER\n    uniform mat4 projectionMatrix;\n#endif\n\nfloat nvr_globeEyeDistance(float depth) {\n#ifdef USE_LOGARITHMIC_DEPTH_BUFFER\n    return exp2(2.0 * depth / logDepthBufFC) - 1.0;\n#else\n    return projectionMatrix[3][2] / (depth * 2.0 - 1.0 + projectionMatrix[2][2]);\n#endif\n}\n#if defined(USE_SHADOWMAP) && NUM_DIR_LIGHT_SHADOWS > 0\n    \n    \n    \n    #ifdef NVR_VIEW_SPACE_SHADOW\n        #ifndef CSM_CASCADE_COUNT\n            #define CSM_CASCADE_COUNT NUM_DIR_LIGHT_SHADOWS\n        #endif\n        uniform mat4 nvrCsmShadowMatrixView[CSM_CASCADE_COUNT];\n    #endif\n    uniform mat4 directionalShadowMatrix[NUM_DIR_LIGHT_SHADOWS];\n\n    \n    vec4 nvrWorldShadowCoord(mat4 shadowMatrix, vec3 positionEc) {\n        return shadowMatrix * vec4(cameraPosition + (vec4(positionEc, 0.0) * viewMatrix).xyz, 1.0);\n    }\n#endif\nuniform sampler2D tGlobeNormal;";