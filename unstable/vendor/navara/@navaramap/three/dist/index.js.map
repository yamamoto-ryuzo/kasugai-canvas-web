export default "vec3 nvr_batchIdToColor(float batchId) {\n    float r = floor(batchId / 65536.0);\n    float g = floor(mod(batchId / 256.0, 256.0));\n    float b = floor(mod(batchId, 256.0));\n\n    return vec3(r/255.0, g/255.0, b/255.0);\n}\n\n#include <common>\n#include <color_pars_fragment>\n\nuniform vec3 color;\nuniform float nvr_uPickable;\n\nflat in float nvr_vBatchId;\n\n#ifdef USE_BATCH_SHOW_OPACITY\nin float nvr_vShow;\nin float nvr_vOpacity;\n#endif\n\nvoid main() {\n    #ifdef USE_BATCH_SHOW_OPACITY\n\nif (nvr_vShow < 0.5) {\n    discard;\n}\n\nif (nvr_vOpacity <= 0.0) {\n    discard;\n}\n\n#endif\n\n    vec4 diffuseColor = vec4(color, 1.0);\n    #include <clipping_planes_fragment>\n\n    #include <color_fragment>\n\n#ifdef USE_BATCH_SHOW_OPACITY\n    diffuseColor.a *= nvr_vOpacity;\n#endif\n\n    gl_FragColor = diffuseColor;\n    #include <colorspace_fragment>\n\n    if(nvr_uPickable > 0.0) {\n        vec3 pickColor = nvr_batchIdToColor(nvr_vBatchId);\n        gl_FragColor = vec4(pickColor.xyz, 1.0);\n    }\n}";