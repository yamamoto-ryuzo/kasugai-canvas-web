export default "#if USE_ELEVATION_HEATMAP\n  float nvr_branchFreeTernary(bool comparison, float a, float b) {\n    float useA = float(comparison);\n    return a * useA + b * (1.0 - useA);\n}\n\nvec2 nvr_branchFreeTernary(bool comparison, vec2 a, vec2 b) {\n    float useA = float(comparison);\n    return a * useA + b * (1.0 - useA);\n}\n\nvec3 nvr_branchFreeTernary(bool comparison, vec3 a, vec3 b) {\n    float useA = float(comparison);\n    return a * useA + b * (1.0 - useA);\n}\n\nvec4 nvr_branchFreeTernary(bool comparison, vec4 a, vec4 b) {\n    float useA = float(comparison);\n    return a * useA + b * (1.0 - useA);\n}\n  #ifndef DEM_UTIL_GLSL\n#define DEM_UTIL_GLSL\n\nbool isPowerOfTwo(int n) {\n  return n > 0 && ((n & (n - 1)) == 0);\n}\n\nconst float invalidHeight = -999999.0; \nbool isValidHeight(float h) {\n  return h > -999998.0; \n}\n\nstruct DEMBilinearData {\n  ivec2 p00, p10, p01, p11;  \n  vec2 frac;                  \n};\n\nDEMBilinearData prepareDEMBilinear(ivec2 actualTexSize, vec2 uv) {\n  vec2 paddedTexSize = vec2(actualTexSize);\n\n  \n  \n  \n  bool hasPadding = !isPowerOfTwo(actualTexSize.x);\n\n  vec2 contentSize = hasPadding ? paddedTexSize - vec2(2.0) : paddedTexSize;\n\n  \n  \n  \n  \n  \n  \n  \n  \n  vec2 pixelCoord = hasPadding\n    ? uv * (contentSize - vec2(1.0)) + vec2(1.0)  \n    : uv * (contentSize - vec2(1.0));              \n\n  vec2 pixelFloor = floor(pixelCoord);\n  vec2 pixelFrac = fract(pixelCoord);\n\n  \n  \n  ivec2 maxCoord = ivec2(paddedTexSize) - ivec2(1);\n\n  DEMBilinearData data;\n  data.p00 = clamp(ivec2(pixelFloor), ivec2(0), maxCoord);\n  data.p10 = clamp(ivec2(pixelFloor + vec2(1.0, 0.0)), ivec2(0), maxCoord);\n  data.p01 = clamp(ivec2(pixelFloor + vec2(0.0, 1.0)), ivec2(0), maxCoord);\n  data.p11 = clamp(ivec2(pixelFloor + vec2(1.0, 1.0)), ivec2(0), maxCoord);\n  data.frac = pixelFrac;\n\n  return data;\n}\n\nfloat decodeDEMHeight(vec4 color, vec3 rgbScaler, float boundary, float minOffset, float maxOffset, float epsilon, float offset) {\n  vec3 rgb = color.rgb * 255.0;\n  float x = dot(rgb, rgbScaler);\n\n  float h;\n  float epsilon_cmp = 1.0; \n  if (abs(x - boundary) > epsilon_cmp) {\n    if (x > boundary) {\n      h = x + maxOffset;  \n    } else {\n      h = x + minOffset;  \n    }\n    \n    h = h * epsilon + offset;\n  } else {\n    h = invalidHeight;  \n  }\n\n  return h;\n}\n\nfloat interpolateDEMHeights(float h00, float h10, float h01, float h11, vec2 frac) {\n  \n  if (!isValidHeight(h00)) return invalidHeight;\n\n  \n  \n  float maxReasonableDiff = 1000.0;\n  \n  \n  if (isValidHeight(h10) && abs(h10 - h00) > maxReasonableDiff) h10 = h00;\n  if (isValidHeight(h01) && abs(h01 - h00) > maxReasonableDiff) h01 = h00;\n  if (isValidHeight(h11) && abs(h11 - h00) > maxReasonableDiff) h11 = h00;\n\n  \n  if (!isValidHeight(h10)) h10 = h00;\n  if (!isValidHeight(h01)) h01 = h00;\n  if (!isValidHeight(h11)) h11 = h00;\n\n  \n  float h0 = mix(h00, h10, frac.x);\n  float h1 = mix(h01, h11, frac.x);\n  return mix(h0, h1, frac.y);\n}\n\n#endif\n\n  uniform sampler2D uColorMapTexture;\n  uniform vec3 uElevationRGBScaler;\n  uniform vec3 uElevationMinMaxHeightAndBoundary;\n  uniform vec4 uElevationMinMaxOffsetAndEpsilonAndOffset;\n  uniform bool uLogarithmic; \n  uniform float uLogBase; \n  uniform float uLogBoundary; \n\n  float pseudoLog(float value) {\n    return value > uLogBoundary ? log(value) / uLogBase : value < -uLogBoundary ? -log(-value) / uLogBase : value / uLogBoundary;\n  }\n\n  \n  float decodeRawHeightForElevation(vec4 color) {\n    return decodeDEMHeight(\n      color,\n      uElevationRGBScaler,\n      uElevationMinMaxHeightAndBoundary.z,  \n      uElevationMinMaxOffsetAndEpsilonAndOffset.x,  \n      uElevationMinMaxOffsetAndEpsilonAndOffset.y,  \n      uElevationMinMaxOffsetAndEpsilonAndOffset.z,  \n      uElevationMinMaxOffsetAndEpsilonAndOffset.w   \n    );\n  }\n\n  \n  float normalizeElevationHeight(float h) {\n    \n    float minHeight = nvr_branchFreeTernary(uLogarithmic, pseudoLog(uElevationMinMaxHeightAndBoundary.x), uElevationMinMaxHeightAndBoundary.x);\n    float maxHeight = nvr_branchFreeTernary(uLogarithmic, pseudoLog(uElevationMinMaxHeightAndBoundary.y), uElevationMinMaxHeightAndBoundary.y);\n    float value = nvr_branchFreeTernary(uLogarithmic, pseudoLog(h), h);\n\n    return clamp(\n        (value - minHeight) / (maxHeight - minHeight),\n        0.0,\n        1.0\n    );\n  }\n\n  \n  \n  \n  \n  \n  \n  \n  \n  float sampleElevationBilinear(sampler2D demTexture, vec2 uv, ivec2 texSize, out bool valid) {\n    \n    DEMBilinearData data = prepareDEMBilinear(texSize, uv);\n\n    float h = invalidHeight; \n\n    \n    float h00 = decodeRawHeightForElevation(texelFetch(demTexture, data.p00, 0));\n    if(isValidHeight(h00)) {\n      float h10 = decodeRawHeightForElevation(texelFetch(demTexture, data.p10, 0));\n      float h01 = decodeRawHeightForElevation(texelFetch(demTexture, data.p01, 0));\n      float h11 = decodeRawHeightForElevation(texelFetch(demTexture, data.p11, 0));\n\n      \n      h = interpolateDEMHeights(h00, h10, h01, h11, data.frac);\n    }\n\n    valid = isValidHeight(h);\n    if (!valid) {\n      return 0.0;\n    }\n\n    \n    return normalizeElevationHeight(h);\n  }\n#endif";